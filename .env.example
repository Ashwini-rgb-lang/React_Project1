# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/car_rental
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/car_rental
MONGO_URI=mongodb://127.0.0.1:27017/car_rental

# Server port
PORT=5000

# Comma-separated list of allowed origins for CORS (your React app URL)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Google Maps API key (only if you re-enable Places autocomplete on the frontend)
GOOGLE_MAPS_API_KEY=
